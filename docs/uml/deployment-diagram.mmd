%% AstraNotes - Deployment Diagram (3-tier, GUI frontend)
%% Local-first, single-user Python desktop app. One node (user workstation),
%% one process (python -m astranotes). Pivoted Week 7.2 (ADR-006) from a CLI
%% to a CustomTkinter GUI: presentation tier = gui/ (view + controller),
%% logic tier = services/, data tier = repositories/ + filesystem.

flowchart TB
    subgraph Workstation["User workstation - Python 3.10+ with Tcl/Tk"]
        direction TB

        subgraph Process["Process - python -m astranotes (single user, single instance)"]
            direction TB

            subgraph Presentation["Presentation tier - gui/"]
                VIEW[app.AstraNotesApp<br/>CustomTkinter view - thin shell]
                CTRL[controller.NotesController<br/>widget-free, headlessly testable]
            end

            subgraph Logic["Logic tier - services/"]
                MGR[NoteManager]
                VAL[ValidationLayer]
                PRV[PrivacyService]
            end

            subgraph Data["Data tier - repositories/"]
                BASE[NoteRepository - ABC]
                JFR[JsonFileRepository]
            end

            subgraph Models["models/"]
                NOTE[Note dataclass]
                EXC[exceptions:<br/>NoteNotFoundError,<br/>PersistenceError,<br/>ValidationError]
            end

            subgraph Deps["Third-party dependencies (pyproject.toml, SPR-04)"]
                CTK[customtkinter 5.2.2<br/>GUI toolkit<br/>License: CC0-1.0 - ADR-006]
                CRYPT[cryptography 44.0.0<br/>Fernet symmetric encryption<br/>License: Apache 2.0 / BSD]
                PYTEST[pytest 8.3.4<br/>dev only<br/>License: MIT]
            end

            CLIH[cli.app - retained dev/test harness only]
        end

        subgraph FS["Local filesystem (user-owned, not in repo)"]
            DATA[("data/<br/>{uuid}.json files<br/>FR-05, FR-06")]
            KEY[("Fernet key store<br/>strategy = ADR-005 pending<br/>SPR-01")]
        end
    end

    VIEW --> CTRL
    CTRL --> MGR
    CLIH -.legacy seam.-> MGR
    VIEW --> CTK
    MGR --> VAL
    MGR --> PRV
    MGR --> JFR
    JFR -.implements.-> BASE
    JFR --> NOTE
    JFR --> EXC
    PRV --> CRYPT
    PRV --> KEY
    JFR --> DATA
